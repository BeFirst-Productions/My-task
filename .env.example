# ==============================================================================
# ROOT / DOCKER COMPOSE ENVIRONMENT VARIABLES
# ==============================================================================
# Copy this file to .env before starting Docker Compose:
#   cp .env.example .env

# PostgreSQL Container Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=task_saas_db
# Host port exposed by Docker Compose (default 5436 avoids conflict with any local 5432)
POSTGRES_PORT=5436

# Full Database connection URL for backend services running on host
DATABASE_URL=postgresql://postgres:postgres@localhost:5436/task_saas_db?schema=public
