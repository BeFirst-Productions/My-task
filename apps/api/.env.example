# ==============================================================================
# API SERVER ENVIRONMENT VARIABLES
# ==============================================================================
# Copy this file to .env before starting the API server:
#   cp .env.example .env

# Runtime Environment (development | production | test)
NODE_ENV=development

# Server Network Configuration
HOST=0.0.0.0
PORT=4000

# Allowed CORS Origin for Frontend Client
CORS_ORIGIN=http://localhost:3000

# PostgreSQL Connection String (uses host port from root docker-compose.yml)
DATABASE_URL=postgresql://postgres:postgres@localhost:5436/task_saas_db?schema=public

# ==============================================================================
# BUNNY STORAGE & CDN CONFIGURATION (Trade Licence & Document Storage)
# ==============================================================================
# Bunny.net Storage Zone Name (from Bunny Dashboard -> Storage)
BUNNY_STORAGE_ZONE_NAME=omniexpiry-storage
# Storage Zone Password / API Access Key
BUNNY_STORAGE_ACCESS_KEY=your-bunny-storage-access-key
# Storage Zone Primary Region: de (Germany), uk (London), ny (New York), la (Los Angeles), sg (Singapore), syd (Sydney)
BUNNY_STORAGE_REGION=de
# Bunny CDN Pull Zone Hostname / URL for public file access
BUNNY_CDN_URL=https://omniexpiry.b-cdn.net
