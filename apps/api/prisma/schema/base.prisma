datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
  output   = "../../src/generated/client"
}

enum Role {
  PLATFORM_OWNER
  SUPER_ADMIN
  ADMIN
  STAFF
  SALES_STAFF
  ACCOUNTANT
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  INVITED
}

enum OrganisationStatus {
  PENDING
  ACTIVE
  INACTIVE
  SUSPENDED
}
